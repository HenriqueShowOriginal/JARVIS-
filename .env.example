# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twitch
TWITCH_BOT_TOKEN=oauth:your_twitch_oauth_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_BOT_NICK=JarvisBot
TWITCH_CHANNELS=your_channel_name

# TTS Settings
TTS_VOICE=pt-BR-FranciscaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_ENABLED=true

# JARVIS Personality
STREAMER_NAME=Streamer
JARVIS_LANGUAGE=pt-BR
JARVIS_PERSONALITY=friendly,funny,helpful

# Moderation
AUTO_MODERATION=true
BAN_ON_EXTREME=false
TIMEOUT_DURATION=60

# Database
DB_PATH=data/jarvis.db
